{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-ai.local/schemas/connector-request.v1.json",
  "title": "Creator Connector Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "connector_id", "operation", "params"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "connector_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "params": {"type": "object"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_provider_requests": {"const": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 50000000}
      }
    }
  }
}
