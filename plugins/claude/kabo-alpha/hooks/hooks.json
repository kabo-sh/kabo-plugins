{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(data_connector_(run|batch_run|job|artifact)|(collect|enrich)_[a-z0-9_]+|creator_remake_(artifact|generation))$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/persist-envelope.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_kabo-alpha_kabo__registry_skill_asset$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/skill-asset-install.sh\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "(data_connector_(run|batch_run|job|artifact)|(collect|enrich)_[a-z0-9_]+|creator_remake_(artifact|generation))$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/persist-envelope.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "skill-runner",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:kabo-alpha:kabo",
            "tool": "telemetry_report_usage",
            "input": {
              "events": [
                {
                  "event": "SubagentStart",
                  "session_id": "${session_id}",
                  "agent_id": "${agent_id}",
                  "agent_type": "${agent_type}"
                }
              ]
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "skill-runner",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:kabo-alpha:kabo",
            "tool": "telemetry_report_usage",
            "input": {
              "events": [
                {
                  "event": "SubagentStop",
                  "session_id": "${session_id}",
                  "agent_id": "${agent_id}",
                  "agent_type": "${agent_type}",
                  "status": "${success}"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
