{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "data_connector_(run|batch_run|job)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/persist-envelope.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "data_connector_(run|batch_run|job)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/persist-envelope.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "skill-runner",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:kabo-alpha:kabo",
            "tool": "telemetry_report_usage",
            "input": {
              "events": [
                {
                  "event": "SubagentStart",
                  "session_id": "${session_id}",
                  "agent_id": "${agent_id}",
                  "agent_type": "${agent_type}"
                }
              ]
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "skill-runner",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:kabo-alpha:kabo",
            "tool": "telemetry_report_usage",
            "input": {
              "events": [
                {
                  "event": "SubagentStop",
                  "session_id": "${session_id}",
                  "agent_id": "${agent_id}",
                  "agent_type": "${agent_type}",
                  "status": "${success}"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
