{
  "mcpServers": {
    "kabo": {
      "url": "https://kabo.sh/mcp",
      "auth": "oauth",
      "http_headers": {
        "X-Kabo-Plugin-Version": "0.21.29"
      }
    },
    "kabo_runtime": {
      "command": "node",
      "args": [
        "scripts/runtime-server.js"
      ],
      "cwd": ".",
      "env_vars": [
        "KABO_CODEX_DATA",
        "KABO_API_ENDPOINT"
      ]
    },
    "kabo_links": {
      "command": "node",
      "args": [
        "scripts/link-server.js"
      ],
      "cwd": ".",
      "env_vars": [
        "KABO_CODEX_DATA"
      ]
    }
  }
}
