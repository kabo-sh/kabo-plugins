#!/usr/bin/env node
// skill-unpack - writes a SkillPackage JSON to disk as a cache directory tree.
// Usage:
//   skill-unpack [--verify] <path to package.json|-> [dest-root]
//     - when the source argument is "-", the SkillPackage JSON is read from stdin
//     - dest-root defaults to <data root>/skill-cache (the data root is $KABO_CODEX_DATA or ~/.kabo/codex)
//     - --verify may appear anywhere in argv
// On-disk layout: <dest-root>/<id>/<version>/ containing every file + .meta.json
//   .meta.json = {id, version, checksum, signature, format_version?, key_id?, downloaded_at}
// Note: this script only writes to disk and performs no verification of its own; bin/skill-verify must
// pass before execution. --verify does not change that: it hands the freshly written directory to
// bin/skill-verify as a child process and exits with the child's exit code - nothing is skipped.
//
// Why --verify exists: fetch -> unpack -> verify used to be three host round trips, and the last two
// were pure ceremony - the agent had nothing to decide between them, and the verify result is required
// before anything else may happen. Folding the verify call into the unpack process makes "cache this
// skill and prove it is genuine" one Bash call, and the manifest digest printed in between is the only
// thing the agent needs from the package to route the run (execution mode, required tools, plugin
// floor), so it no longer opens manifest.json in a further turn either. On Codex that one call is the
// tail of the raw-PTY download bridge (stty raw -echo && dd ... | skill-unpack --verify - <dest-root>),
// so download, unpack, digest and verify happen inside a single command. The digest is printed before
// verification and is informational: routing on it is fine, executing anything still waits for the
// verify line.
//
// stdout is relay-safe by contract (the runner relays it off the machine), so no absolute path under
// the user's home may appear there: the "Written:" line names the cache-relative directory and the
// digest names manifest fields only, each reduced to an allowlisted token (see manifestDigest) - the
// package is unverified at that point and must not be able to write its own lines. Absolute paths
// are for stderr.
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { cacheRoot, ensurePrivateDir, readJsonSilent, PLUGIN_ARTIFACT_FORMAT_VERSION } from '../scripts/lib/common.js';
const USAGE = `Usage: skill-unpack [--verify] <path to package.json|-> [dest-root]
  Reads a SkillPackage JSON from a file or stdin(-) and writes it to <dest-root>/<id>/<version>/
  dest-root defaults to $KABO_CODEX_DATA/skill-cache (or ~/.kabo/codex/skill-cache when unset)
  --verify then runs skill-verify on the written directory and exits with its exit code`;
function die(msg) {
  console.error(msg);
  process.exit(1);
}
/** stdout goes through a synchronous write on the raw fd rather than console.log: with --verify the
 *  child inherits this fd, and console.log on a pipe is not guaranteed to have handed its bytes to the
 *  kernel before the next statement runs, so the digest could land below the child's verify line in a
 *  relayed transcript. */
function out(line) {
  fs.writeSync(1, `${line}\n`);
}
/** C0 and C1 control characters plus DEL: newline, ESC (ANSI sequences), 8-bit CSI, NUL. */
const CONTROL_CHARS = /[\u0000-\u001f\u007f-\u009f]/;
/** Path-traversal guard: reject absolute paths, backslashes, control characters, empty segments, and
 *  segments starting with ".".
 *  Dotfile segments must be rejected: the server's packaging and skill-verify's checksum recomputation
 *  both exclude dotfiles, so if the unpacking side let them through, a dotfile inside a package would
 *  become a smuggling channel around signature verification (a MITM stuffs a .xxx file into a
 *  legitimately signed package and verify still passes).
 *  Control characters must be rejected because id and version are echoed on relay-safe stdout before
 *  the package is verified: a newline in either would let the package append a line of its own -
 *  a forged "Verification passed:" - to the "Written:" line, and an ESC would reach the user's
 *  terminal. No legitimate package names a file or a version that way. */
function assertSafeRelPath(p) {
  if (typeof p !== 'string' || p === '' || path.isAbsolute(p) || p.includes('\\') || CONTROL_CHARS.test(p)) {
    die(`SkillPackage contains an illegal file path: ${JSON.stringify(p)}`);
  }
  for (const seg of p.split('/')) {
    if (seg === '' || seg.startsWith('.')) {
      die(`SkillPackage contains an illegal file path: ${JSON.stringify(p)}`);
    }
  }
}
async function readSource(src) {
  if (src === '-') {
    const chunks = [];
    for await (const chunk of process.stdin) chunks.push(chunk);
    return Buffer.concat(chunks).toString('utf8');
  }
  return fs.readFileSync(src, 'utf8');
}
/** What a digest value may look like: mode names, operation names, mcp__... tool names, semver.
 *  Everything else prints as "-". The digest is printed from a manifest nobody has verified yet, on
 *  the same stdout the agent reads the verify result from, so values are allowlisted rather than
 *  escaped: a hostile or MITM'd package could otherwise put a newline plus a forged "Verification
 *  passed:" line - or an ANSI escape aimed at the user's terminal - into execution or required.tools
 *  and have it printed above the real failure. No separator of the digest line (space, "=", ",",
 *  "@") is in the set, so a value can never pass for a second field either. */
const DIGEST_TOKEN = /^[A-Za-z0-9._+-]{1,128}$/;
function digestToken(value) {
  return typeof value === 'string' && DIGEST_TOKEN.test(value) ? value : '-';
}
/** One-line digest of the fields the agent routes on, read back from the manifest.json that was just
 *  written - the signed copy, not pkg.manifest from the envelope, so what is printed is what
 *  skill-verify will check. Missing, unreadable or non-allowlisted values print as "-" and never fail
 *  the unpack: a package without a usable manifest is skill-verify's to reject, with its own
 *  error_type. */
function manifestDigest(dest, pkg) {
  const parsed = readJsonSilent(path.join(dest, 'manifest.json'));
  const manifest = parsed && typeof parsed === 'object' ? parsed : {};
  let execution = '-';
  if (typeof manifest.execution === 'string') {
    execution = digestToken(manifest.execution);
  } else if (manifest.execution && typeof manifest.execution === 'object' && !Array.isArray(manifest.execution)) {
    // The object form is rebuilt from allowlisted keys and values, never stringified as found: only
    // the {default, operations: {<operation>: mode}} shape the dispatcher reads survives.
    const ex = manifest.execution;
    const safe = {};
    if (ex.default !== undefined) safe.default = digestToken(ex.default);
    if (ex.operations && typeof ex.operations === 'object' && !Array.isArray(ex.operations)) {
      safe.operations = {};
      for (const [op, mode] of Object.entries(ex.operations)) {
        if (DIGEST_TOKEN.test(op)) safe.operations[op] = digestToken(mode);
      }
    }
    execution = JSON.stringify(safe);
  }
  const tools = manifest.required && Array.isArray(manifest.required.tools)
    ? manifest.required.tools.map(digestToken)
    : [];
  // id/version are control-character-free already (assertSafeRelPath); the allowlist keeps them from
  // passing for another field. The "Written:" line above carries them verbatim.
  return `manifest: execution=${execution}`
    + ` required.tools=${tools.length > 0 ? tools.join(',') : '-'}`
    + ` min_plugin_version=${digestToken(manifest.min_plugin_version)}`
    + ` skill=${digestToken(pkg.id)}@${digestToken(pkg.version)}`;
}
async function main() {
  // --verify is the only option and may sit anywhere; everything else stays positional so that "-"
  // (stdin) and the optional dest-root keep working exactly as before.
  const verify = process.argv.slice(2).includes('--verify');
  const args = process.argv.slice(2).filter((a) => a !== '--verify');
  if (args.length === 0 || args[0] === '--help' || args[0] === '-h') {
    out(USAGE);
    process.exit(args.length === 0 ? 1 : 0);
  }
  if (args.length > 2) die(`Too many arguments\n\n${USAGE}`);
  let pkg;
  try {
    pkg = JSON.parse(await readSource(args[0]));
  } catch (err) {
    die(`Failed to read/parse the SkillPackage JSON: ${err.message}`);
  }
  // Basic shape validation
  if (!pkg || typeof pkg.id !== 'string' || !pkg.id) die('SkillPackage is missing id');
  if (typeof pkg.version !== 'string' || !pkg.version) die('SkillPackage is missing version');
  if (!Array.isArray(pkg.files) || pkg.files.length === 0) die('SkillPackage is missing files');
  if (typeof pkg.checksum !== 'string' || typeof pkg.signature !== 'string') {
    die('SkillPackage is missing checksum/signature');
  }
  // Fail closed on a format this plugin cannot verify, and fail here rather than three steps later:
  // unpacking it would leave a cache entry that skill-verify can only ever reject, and the reason
  // ("checksum mismatch") would point at tampering instead of at a plugin that is too old.
  // An absent field is the legacy shape and is accepted - see artifactFormatOf in common.js.
  if (pkg.format_version !== undefined && pkg.format_version !== null
      && pkg.format_version !== PLUGIN_ARTIFACT_FORMAT_VERSION) {
    die(`SkillPackage declares artifact format_version ${JSON.stringify(pkg.format_version)}, which this plugin cannot verify; upgrade the plugin`);
  }
  // id/version also become directory names, so they need the same traversal guard
  assertSafeRelPath(pkg.id);
  assertSafeRelPath(pkg.version);
  if (pkg.id.includes('/') || pkg.version.includes('/')) die('id/version must not contain "/"');
  // Validate every files entry before touching the destination directory - so a bad package cannot
  // wipe an existing cache and then fail halfway through
  for (const f of pkg.files) {
    if (!f || typeof f.path !== 'string' || typeof f.content_base64 !== 'string') {
      die('a files entry is missing path/content_base64');
    }
    assertSafeRelPath(f.path);
  }
  const destRoot = args[1] ? path.resolve(args[1]) : cacheRoot();
  const dest = path.join(destRoot, pkg.id, pkg.version);
  // Clear the old contents and rewrite wholesale, so the directory matches the package exactly.
  // ensurePrivateDir, not a bare mkdirSync: with the default dest-root this call is what
  // materializes <data root>/skill-cache (and on a fresh machine the data root itself, ~/.kabo
  // included), and a modeless mkdir left the whole chain 0755 - the onboarding-field-test
  // permission regression.
  fs.rmSync(dest, { recursive: true, force: true });
  ensurePrivateDir(dest);
  for (const f of pkg.files) {
    const target = path.join(dest, f.path);
    ensurePrivateDir(path.dirname(target));
    fs.writeFileSync(target, Buffer.from(f.content_base64, 'base64'));
  }
  const meta = {
    id: pkg.id,
    version: pkg.version,
    checksum: pkg.checksum,
    signature: pkg.signature,
    // The format version has to survive to disk, because skill-verify runs later, from the cache
    // directory, with no access to the response body - without this field it cannot tell which
    // canonical bytes produced meta.checksum and would have to guess. Omitted when the package omits
    // it: absent means "the legacy bytes", and writing a default would turn a legacy package into an
    // unverifiable one.
    //
    // .meta.json is a dotfile and therefore outside signature coverage, the same status as key_id
    // below. That is safe for the same reason: tampering with this field can only change **which
    // algorithm is tried**, and every wrong choice produces a checksum that does not match the
    // signed one. It can cause a refusal, never an acceptance.
    ...(pkg.format_version === undefined || pkg.format_version === null
      ? {}
      : { format_version: pkg.format_version }),
    // key_id is a hint for "which key this signature came from" and is not in the signed manifest
    // (the checksum only covers files), so it can be tampered with; skill-verify uses it only to
    // order the keys it tries and to decide whether to refresh the keyset.
    // Its absence is harmless - verify then simply tries every pinned key in turn.
    ...(typeof pkg.key_id === 'string' && pkg.key_id ? { key_id: pkg.key_id } : {}),
    downloaded_at: new Date().toISOString(),
  };
  fs.writeFileSync(path.join(dest, '.meta.json'), JSON.stringify(meta, null, 2) + '\n');
  // Since 0.9.0 the client no longer reports skill_download itself: the local telemetry buffer and the
  // REST channel have been removed entirely, and the server already records this signal in the
  // registry_skill_download handler (with skill_id and the version actually served), so repeating it
  // on the client is pointless.
  //
  // Cache-relative on purpose (see the header): the last segment of dest-root is "skill-cache" for the
  // default root and whatever the caller named for a custom one, never the path above it.
  out(`Written: ${pkg.id}@${pkg.version} -> ${path.basename(destRoot)}/${pkg.id}/${pkg.version} (${pkg.files.length} file(s) + .meta.json)`);
  out(manifestDigest(dest, pkg));
  if (!verify) {
    out('Reminder: skill-verify must pass before execution.');
    return;
  }
  // The sibling by file location, never by name: on Codex the plugin's bin/ is not on PATH at all
  // (skills call it by absolute path), and even where a host does expose it, this process must run
  // the skill-verify that ships with the same plugin install as itself.
  const verifyBin = path.join(path.dirname(fileURLToPath(import.meta.url)), 'skill-verify');
  const result = spawnSync(process.execPath, [verifyBin, dest], { stdio: 'inherit' });
  if (result.error) die(`skill-verify could not be started: ${result.error.message}`);
  // A child killed by a signal has no status; that is a failed verification, not a pass.
  process.exit(result.status === null ? 1 : result.status);
}
main().catch((err) => die(`skill-unpack failed: ${err.message}`));
