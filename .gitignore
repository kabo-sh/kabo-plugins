.DS_Store
# The support tree ships .py now (snapshot_store.py, build_public_snapshot.py). Bytecode is not a
# published artifact, and both variants' creator-research/ trees are held by a treeOf file-list mirror
# assertion: compiling or running only one side leaves a one-sided __pycache__ and fails the suite as
# "both variants must ship the same creator-research support tree" - an error naming the wrong cause.
__pycache__/
*.py[cod]

# Claude Code's local working state, including .claude/worktrees/ - full checkouts of this repo at
# arbitrary refs. This tree is a published mirror, so one `git add -A` on an unignored .claude/
# would commit whatever those checkouts happen to contain.
.claude/
