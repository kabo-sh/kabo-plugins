.DS_Store

# The plugins ship .py files (snapshot_store.py, build_public_snapshot.py). Bytecode is not a
# published artifact, and both variants' creator-research/ trees must stay byte-identical - running
# a script in only one of them would otherwise leave a one-sided __pycache__ and break that mirror.
__pycache__/
*.py[cod]
